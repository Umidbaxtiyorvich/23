# ================= IELTS AI MASTER — backend sozlamalari =================
APP_NAME="IELTS AI MASTER"
ENVIRONMENT=development          # production da test to'lovlar va dev havolalar o'chadi
DEBUG=false

DATABASE_URL=postgresql+psycopg://ielts:ielts@localhost:5432/ielts_ai_master

# JWT — productionda uzun tasodifiy qiymat qo'ying:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ---------------- AI provayderlar (kalitlar FAQAT shu yerda) ----------------
# AI_PROVIDER: groq | openai | gemini | none   (admin paneldan ham almashtiriladi)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60

# ---------------- Email (bo'sh bo'lsa havolalar server logiga yoziladi) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.uz
SMTP_TLS=true
# Faqat development: tasdiqlash/tiklash havolasini API javobida qaytarish (sinash uchun qulay)
EMAIL_DEV_RETURN_LINKS=true

# ---------------- Free tarif cheklovlari ----------------
FREE_AI_DAILY_LIMIT=15
FREE_TESTS_DAILY_LIMIT=3

# ---------------- Rate limit (daqiqasiga, IP bo'yicha) ----------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=300

# ---------------- Seed ----------------
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@ielts-ai-master.example.com
ADMIN_PASSWORD=Admin12345!
